{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "../../desktop-core",
    "paths": { "@shared/*": ["shared/*"] }
  },
  "include": ["../../desktop-core/electron", "../../desktop-core/shared", "../../desktop-core/types", "../../desktop-core/*.ts"]
}
