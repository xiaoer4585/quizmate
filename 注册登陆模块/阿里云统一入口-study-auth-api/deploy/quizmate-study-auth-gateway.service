[Unit]
Description=QuizMate study-auth compatibility gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quizmate-api
Group=quizmate-api
WorkingDirectory=/opt/quizmate-study-auth-gateway
EnvironmentFile=/etc/quizmate-study-auth-gateway.env
ExecStart=/usr/bin/node /opt/quizmate-study-auth-gateway/src/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
