HOST=127.0.0.1
PORT=8100
APP_VERSION=1.0.0
UPSTREAM_URL=http://127.0.0.1:8200/study-auth-api
UPSTREAM_TIMEOUT_MS=90000
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_VLM_PATH=/v1/coding_plan/vlm
VISION_TIMEOUT_MS=90000
OCR_FALLBACK_ENABLED=true
OCR_COMMAND=/usr/bin/tesseract
OCR_LANGUAGES=chi_sim+eng
OCR_TIMEOUT_MS=45000
OCR_MIN_CHARS=30
OCR_MIN_CONFIDENCE=65
MAX_BODY_BYTES=8388608
MAX_SCREENSHOT_BYTES=6291456
UPLOAD_TTL_SECONDS=300
UPLOAD_TICKET_SECRET=replace-with-at-least-32-random-characters
READ_TTL_SECONDS=900
OSS_REGION=oss-cn-beijing
OSS_BUCKET=quizmate-ai-screenshots-cuolemo
OSS_PREFIX=screenshots/
ECS_RAM_ROLE_NAME=QuizMateOssGatewayRole
CORS_ORIGINS=*
