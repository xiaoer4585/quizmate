{
  "manifest_version": 3,
  "name": "QuizMate 网申助手",
  "version": "2.2.0",
  "description": "根据个人档案自动识别并填写招聘网站的网申表单",
  "permissions": ["storage", "scripting", "activeTab", "tabs", "downloads", "alarms", "notifications", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QuizMate 网申助手"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
