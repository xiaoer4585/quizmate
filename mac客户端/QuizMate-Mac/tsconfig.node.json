{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": "../../desktop-core",
    "paths": {
      "@shared/*": ["shared/*"],
      "*": ["node_modules/*", "../mac客户端/QuizMate-Mac/node_modules/*"]
    }
  },
  "include": ["../../desktop-core/electron", "../../desktop-core/shared", "../../desktop-core/types", "../../desktop-core/*.ts"],
  "exclude": ["../../desktop-core/shared/__tests__"]
}
